# Modelo das variáveis de ambiente do projeto.
# Copie para .env antes de subir os containers:
#   copy .env.example .env      (Windows - Prompt/PowerShell)
#   cp .env.example .env        (Linux/macOS/Git Bash)
# O .env NÃO vai para o Git; troque os valores no seu .env se quiser.
POSTGRES_USER=senai
POSTGRES_PASSWORD=senai
POSTGRES_DB=restaurante
